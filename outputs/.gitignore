# ==============================================================================
# Outputs Directory - Local Git Ignore Policy
# 实验输出专用隔离规则
# ==============================================================================

# 默认忽略 outputs 目录下的所有生成产物
*

# 豁免自身、子目录骨架及 .gitkeep 保活文件
!.gitignore
!.gitkeep
!*/

# 确保子目录骨架可被追踪
!checkpoints/
!figures/
!manifests/
!metrics/
!splits/
!tables/

# 严格屏蔽检查点权重、图片与日志产物
checkpoints/*
figures/*
logs/*
*.pt
*.pth
*.ckpt
*.bin
*.safetensors
*.png
*.jpg
*.jpeg
*.log

# 确保所有子目录下的 .gitkeep 保活文件均被保留
!**/.gitkeep

# ------------------------------------------------------------------------------
# 实验元数据与划分表、指标报告及关键图表（纳入版本管理作为复现证据）
# ------------------------------------------------------------------------------
!splits/*.json
!manifests/*.json
!metrics/*.json
!normalization/*.pt
!normalization/*.json
!figures/*.png
!tables/*.tex
